ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def vlen(text):
    """Visible width, ignoring colour escapes."""
    return len(ANSI_RE.sub("", text))


class Frame:
    """A titled box that pads around colour codes correctly."""

    def __init__(self, width, palette):
        self.w = width
        self.c = palette
        self.lines = []

    def top(self, left, right):
        inner = self.w - 2
        text = f"{G.h} {left} "
        tail = f" {right} {G.h}" if right else G.h
        fill = max(0, inner - len(text) - len(tail))
        self.lines.append(self.c("2", G.tl + text + G.h * fill + tail + G.tr))

    def bottom(self, hint):
        inner = self.w - 2
        tail = f"{G.h} {hint} " if hint else ""
        fill = max(0, inner - len(tail))
        self.lines.append(self.c("2", G.bl + tail + G.h * fill + G.br))

    def row(self, content=""):
        pad = max(0, self.w - 4 - vlen(content))
        bar = self.c("2", G.v)
        self.lines.append(f"{bar} {content}{' ' * pad} {bar}")

    def section(self, title, note=""):
        line = self.c("1", title)
        if note:
            line += self.c("2", f"   {note}")
        self.row(line)


def build_live(meters, lead, spec, findings, profile, palette, width,
               elapsed, source_desc, view, warn):
    c = palette
    target_rms, target_peak, _ = PROFILES[profile]
    lo, hi = target_rms - RMS_TOLERANCE, target_rms + RMS_TOLERANCE
    s = meters[lead].summary()
    inner = width - 4

    right = f"{source_desc}"
    if KNOB.preamp:
        right += f" {G.sep} {KNOB.preamp}"
    right += f" {G.sep} {int(elapsed) // 60:02d}:{int(elapsed) % 60:02d}"

    f = Frame(width, palette)
    f.top("mic analyzer", ellipsize(right, max(20, inner - 20)))

    if view in ("level", "full"):
        f.row()
        f.section("LEVEL")
        mwidth = min(max(inner - 22, 30), 67)
        lm = LevelMeter(mwidth, palette)
        labels, ticks = lm.ruler()
        f.row("    " + c("2", labels))
        f.row("    " + c("2", ticks))
        for i, m in enumerate(meters):
            live = m.summary()["alive"]
            tag = c("1" if i == lead else "2", f" {'LR'[i]}  ")
            if not live and i != lead:
                body = c("2", f"{G.h} silent {G.h}".ljust(mwidth))
                suffix = c("2", "    --") + c("2", "     ")
            else:
                body = lm.bar(m.rms_db, m.hold_db, lo, hi)
                suffix = c("1", fmt_db(m.rms_db)) + c("2", " dBFS")
            f.row(tag + body + "  " + suffix)
        f.row("    " + c("2", lm.targets(lo, hi, target_peak)))

    if view in ("spectrum", "full"):
        f.row()
        note = "speech only" if spec.frames else "waiting for speech"
        f.section("SPECTRUM", note)
        swidth = min(max(inner - 8, 30), 72)
        height = 8 if view == "spectrum" else 6
        hot = {fd.area for fd in findings if fd.severity != OK}
        area_band = {"rumble": "rumble", "sibilance": "sibilance",
                     "body": "lowmid", "air": "air"}
        flagged = {band for area, band in area_band.items() if area in hot}
        rows, marks, axis = spectrum_plot(spec, swidth, height, palette,
                                          flagged)
        top_lbl = f"{SPECTRUM_TOP:.0f}"
        bot_lbl = f"{SPECTRUM_TOP - SPECTRUM_RANGE:.0f}"
        for i, r in enumerate(rows):
            gutter = (top_lbl if i == 0 else
                      bot_lbl if i == len(rows) - 1 else "")
            f.row(c("2", gutter.rjust(4)) + " " + r)
        f.row("     " + marks)
        f.row("     " + axis)

    f.row()
    left_w = 24
    read = [("speech", s["speech_rms"], "dBFS"),
            ("peaks", s["speech_peak_p95"], "dBFS"),
            ("crest", s["crest"], "dB"),
            ("floor", s["floor"], "dBFS"),
            ("SNR", (s["speech_rms"] - s["floor"])
             if s["speech_rms"] is not None and s["floor"] is not None
             else None, "dB")]
    left_rows = [c("1", "READINGS")]
    for name, val, unit in read:
        left_rows.append(f" {name:<7}" + c("1", fmt_db(val)) + c("2", f" {unit}"))
    clips = sum(m.summary()["clip_samples"] for m in meters)
    left_rows.append(" clips  " + (c("1;31", f"{clips:>6}") if clips
                                   else c("2", "     0")))

    right_rows = [c("1", "DIAGNOSIS")]
    for fd in findings[:len(left_rows) - 1]:
        mark = c(SEVERITY_COLOUR[fd.severity], G.marks[fd.severity])
        text = fd.action if fd.actionable else fd.reading
        right_rows.append(f"{mark} {fd.area:<10}"
                          + c("2" if fd.severity == OK else "0",
                              ellipsize(text, max(10, inner - left_w - 14))))

    for i in range(max(len(left_rows), len(right_rows))):
        l = left_rows[i] if i < len(left_rows) else ""
        r = right_rows[i] if i < len(right_rows) else ""
        f.row(l + " " * max(1, left_w - vlen(l)) + r)

    state, text = headline(findings)
    top = next((fd for fd in findings if fd.actionable), None)
    f.row()
    line = c(SEVERITY_COLOUR[state] + ";1", f"{G.arrow} {text}")
    if top is not None:
        line += "  " + ellipsize(f"{top.short_control}: {top.action}",
                                 max(20, inner - vlen(line) - 2))
    f.row(line)
    if warn:
        f.row(c("2", warn))
    f.row()
    f.bottom(f" {G.sep} ".join(("q quit", "r reset", "1 level",
                                "2 spectrum", "3 full")))
    return f.lines


def run_live(cap, args, palette, source_desc, warn):
    meters = [ChannelMeter(), ChannelMeter()]
    spec = Spectrum()
    view = args.view
    start = time.monotonic()
    last_draw = 0.0
    findings = []

    with Keys() as keys, Screen() as screen:
        while True:
            raw = cap.read_block()
            if raw is None:
                break
            left, right = unpack_block(raw)
            meters[0].process(left)
            meters[1].process(right)
            lead = 0 if meters[0].max_peak >= meters[1].max_peak else 1
            spec.feed((left, right)[lead], meters[lead].live_gate())

            k = keys.get()
            if k in ("q", "Q", "\x03"):
                break
            if k in ("r", "R"):
                for m in meters:
                    m.reset()
                spec.reset()
                start = time.monotonic()
            if k == "1":
                view = "level"
            elif k == "2":
                view = "spectrum"
            elif k == "3":
                view = "full"

            now = time.monotonic()
            if now - last_draw >= 1 / 20:
                last_draw = now
                findings = diagnose(meters[lead].summary(), spec.band_levels(),
                                    args.profile, KNOB.preamp)
                width = min(term_width(), 108)
                screen.draw(build_live(meters, lead, spec, findings,
                                       args.profile, palette, width,
                                       now - start, source_desc, view, warn))
    return meters, spec


