RATE = 48000
CHANNELS = 2
BLOCK_FRAMES = 1024
BLOCK_BYTES = BLOCK_FRAMES * CHANNELS * 4
BLOCK_SECS = BLOCK_FRAMES / RATE
RMS_WINDOW_SECS = 0.300
CLIP_LEVEL = 0.999
DB_FLOOR = -120.0

FFT_SIZE = 2048
FFT_EVERY = 2                      # blocks between transforms (~23 Hz)

GATE_ABOVE_FLOOR = 12.0
GATE_ABSOLUTE = -50.0
GATE_BELOW_TOP = 20.0
CHANNEL_ALIVE_PEAK = -60.0

DEG_PER_DB = float(os.environ.get("MIC_DEG_PER_DB", "6.0"))
DEG_PER_DB_KNOWN = "MIC_DEG_PER_DB" in os.environ

PROFILES = {
    "voice": (-18.0, -9.0, "recording / calls -- comfortable, lots of headroom"),
    "stream": (-16.0, -7.0, "live streaming -- hotter, for OBS and Discord"),
    "safe": (-22.0, -13.0, "maximum headroom -- loud rooms, shouty talkers"),
}
RMS_TOLERANCE = 3.0

DB_MIN = -66.0
DB_MAX = 0.0
TICKS = [-60, -50, -40, -30, -24, -18, -12, -6, -3, 0]

# Analysis bands. Boundaries follow what the controls on a channel strip
# actually act on, not octave convention: 80 Hz because that is where the
# high-pass filter sits, 5-9 kHz because that is de-esser territory.
BANDS = [
    ("rumble", 20, 80, "<80"),
    ("low", 80, 200, "80-200"),
    ("lowmid", 200, 500, "200-500"),
    ("mid", 500, 2000, "500-2k"),
    ("presence", 2000, 5000, "2k-5k"),
    ("sibilance", 5000, 9000, "5k-9k"),
    ("air", 9000, 16000, "9k-16k"),
]

SPECTRUM_LO = 40.0
SPECTRUM_HI = 16000.0
SPECTRUM_TOP = -12.0               # dB at the top of the spectrum plot
SPECTRUM_RANGE = 60.0              # dB from top to bottom


def dbfs(amplitude):
    """Linear amplitude (0..1) to dBFS, floored instead of diverging at zero."""
    if amplitude <= 1e-6:
        return DB_FLOOR
    return 20.0 * math.log10(amplitude)


def power_db(power):
    if power <= 1e-20:
        return DB_FLOOR
    return 10.0 * math.log10(power)


def percentile(values_sorted, p):
    if not values_sorted:
        return None
    k = (len(values_sorted) - 1) * p / 100.0
    lo, hi = math.floor(k), math.ceil(k)
    if lo == hi:
        return values_sorted[int(k)]
    return values_sorted[lo] + (values_sorted[hi] - values_sorted[lo]) * (k - lo)


def fmt_db(db, width=6):
    if db is None or db <= DB_FLOOR:
        return "--".rjust(width)
    return f"{db:.1f}".rjust(width)


# --------------------------------------------------------------------------
# FFT
# --------------------------------------------------------------------------

def make_fft(n):
    """Iterative radix-2 FFT with precomputed twiddles and bit-reversal.

    Fast enough in pure Python: ~1.3 ms at n=2048 on this machine, so a live
    spectrum at 23 transforms per second costs about 3% of one core.
    """
    levels = n.bit_length() - 1
    rev = [0] * n
    for i in range(n):
        r, x = 0, i
        for _ in range(levels):
            r = (r << 1) | (x & 1)
            x >>= 1
        rev[i] = r
    tw = [cmath.exp(-2j * math.pi * k / n) for k in range(n // 2)]

    def fft(samples):
        out = [samples[rev[i]] for i in range(n)]
        size = 2
        while size <= n:
            half, step = size // 2, n // size
            for i in range(0, n, size):
                k = 0
                for j in range(i, i + half):
                    t = out[j + half] * tw[k]
                    out[j + half] = out[j] - t
                    out[j] = out[j] + t
                    k += step
            size *= 2
        return out
    return fft


class Spectrum:
    """Speech-gated spectral analysis, plus a live display spectrum.

    Two products from the same transforms. The live one is smoothed and decays,
    for something that looks like an analyzer; the accumulated one averages only
    blocks loud enough to be speech, and is what the diagnosis reads -- averaging
    everything would measure the room's air conditioning instead of the voice.
    """

    def __init__(self, size=FFT_SIZE, rate=RATE):
        self.n = size
        self.rate = rate
        self.fft = make_fft(size)
        self.window = [0.5 - 0.5 * math.cos(2 * math.pi * i / size)
                       for i in range(size)]
        # Hann coherent gain is 0.5, so this scale makes a full-scale sine
        # read 0 dBFS at its bin.
        self.scale = 4.0 / size
        self.buf = collections.deque(maxlen=size)
        self.bins = size // 2
        self.freqs = [i * rate / size for i in range(self.bins)]
        self.live = [DB_FLOOR] * self.bins
        self.hold = [DB_FLOOR] * self.bins
        self.accum = [0.0] * self.bins
        self.frames = 0
        self._since = 0
        self.band_ranges = self._band_ranges()

    def _band_ranges(self):
        out = {}
        for name, lo, hi, _ in BANDS:
            a = max(1, int(lo * self.n / self.rate))
            b = min(self.bins, int(hi * self.n / self.rate) + 1)
            out[name] = (a, max(a + 1, b))
        return out

    def feed(self, samples, is_speech):
        """Buffer a block; transform every FFT_EVERY blocks. Returns True if
        a transform ran."""
        self.buf.extend(samples)
        self._since += 1
        if self._since < FFT_EVERY or len(self.buf) < self.n:
            return False
        self._since = 0

        data = list(self.buf)
        spec = self.fft([complex(data[i] * self.window[i], 0.0)
                         for i in range(self.n)])

        decay = 1.5 * FFT_EVERY * BLOCK_SECS * 20.0    # dB per frame
        for i in range(self.bins):
            mag = abs(spec[i]) * self.scale
            db = dbfs(mag)
            self.live[i] = db if db > self.live[i] else max(
                db, self.live[i] - decay)
            self.hold[i] = db if db > self.hold[i] else max(
                db, self.hold[i] - decay * 0.15)
            if is_speech:
                self.accum[i] += mag * mag
        if is_speech:
            self.frames += 1
        return True

    def reset(self):
        self.accum = [0.0] * self.bins
        self.frames = 0
        self.live = [DB_FLOOR] * self.bins
        self.hold = [DB_FLOOR] * self.bins

    def band_levels(self):
        """Speech-average energy per band, in dB relative to the total.

        Relative rather than absolute on purpose: the whole point is tonal
        balance, which must not move when the gain knob does.
        """
        if not self.frames:
            return None
        total = sum(self.accum[self.band_ranges["low"][0]:
                              self.band_ranges["air"][1]])
        if total <= 0:
            return None
        out = {}
        for name, _, _, _ in BANDS:
            a, b = self.band_ranges[name]
            out[name] = power_db(sum(self.accum[a:b]) / total)
        return out

    def display(self, columns):
        """Log-spaced (level dB, hold dB) pairs for the plot."""
        if columns < 1:
            return []
        ratio = math.log(SPECTRUM_HI / SPECTRUM_LO)
        edges = [SPECTRUM_LO * math.exp(ratio * i / columns)
                 for i in range(columns + 1)]
        out = []
        for c in range(columns):
            a = max(1, int(edges[c] * self.n / self.rate))
            b = max(a + 1, int(edges[c + 1] * self.n / self.rate) + 1)
            b = min(b, self.bins)
            if a >= b:
                out.append((DB_FLOOR, DB_FLOOR))
                continue
            out.append((max(self.live[a:b]), max(self.hold[a:b])))
        return out


# --------------------------------------------------------------------------
# Metering
# --------------------------------------------------------------------------

class ChannelMeter:
    """Running level statistics for one channel."""

    HISTORY = 40000
    HOLD_DECAY = 10.0 ** (-BLOCK_SECS)          # 20 dB/s peak-hold falloff

    def __init__(self):
        win = max(1, int(round(RMS_WINDOW_SECS / BLOCK_SECS)))
        self.window = collections.deque(maxlen=win)
        self.history = collections.deque(maxlen=self.HISTORY)
        self.rms_db = DB_FLOOR
        self.peak_db = DB_FLOOR
        self.hold = 0.0
        self.max_peak = 0.0
        self.clip_samples = 0
        self.blocks = 0

    def process(self, samples):
        n = len(samples)
        peak = max(max(samples), -min(samples))
        sumsq = sum(map(operator.mul, samples, samples))

        self.window.append(sumsq / n)
        self.rms_db = dbfs(math.sqrt(sum(self.window) / len(self.window)))
        self.peak_db = dbfs(peak)

        self.hold = max(peak, self.hold * self.HOLD_DECAY)
        if peak > self.max_peak:
            self.max_peak = peak
        if peak >= CLIP_LEVEL:
            self.clip_samples += sum(1 for x in samples
                                     if x >= CLIP_LEVEL or x <= -CLIP_LEVEL)
        self.blocks += 1
        self.history.append((self.rms_db, self.peak_db))

    @property
    def hold_db(self):
        return dbfs(self.hold)

    @property
    def max_peak_db(self):
        return dbfs(self.max_peak)

    def reset(self):
        self.history.clear()
        self.max_peak = 0.0
        self.clip_samples = 0
        self.blocks = 0

    def live_gate(self):
        """Is the signal right now loud enough to be speech?

        Used to gate spectral accumulation in real time, where the full
        history-based gate is not available yet.
        """
        if len(self.history) < 20:
            return False
        rms = sorted(r for r, _ in self.history)
        floor = percentile(rms, 10.0)
        top = percentile(rms, 95.0)
        gate = min(max(floor + GATE_ABOVE_FLOOR, GATE_ABSOLUTE),
                   top - GATE_BELOW_TOP)
        return self.rms_db > gate

    def summary(self, floor_db=None):
        """Noise floor, gated speech level, speech peaks. All dBFS.

        Pass floor_db when the floor was measured separately during a
        known-silent phase: always a better estimate than one inferred from a
        recording that may contain no silence at all.
        """
        hist = list(self.history)
        out = {"floor": None, "speech_rms": None, "speech_peak_p95": None,
               "crest": None, "speech_secs": 0.0, "max_peak": self.max_peak_db,
               "clip_samples": self.clip_samples, "alive": False}
        if not hist:
            return out

        rms_sorted = sorted(r for r, _ in hist)
        floor = floor_db if floor_db is not None else percentile(rms_sorted, 10.0)
        out["floor"] = floor
        out["alive"] = self.max_peak_db > CHANNEL_ALIVE_PEAK

        top = percentile(rms_sorted, 95.0)
        gate = min(max(floor + GATE_ABOVE_FLOOR, GATE_ABSOLUTE),
                   top - GATE_BELOW_TOP)
        speech = [(r, p) for r, p in hist if r > gate]
        if not speech:
            return out

        out["speech_secs"] = len(speech) * BLOCK_SECS
        out["speech_rms"] = percentile(sorted(r for r, _ in speech), 50.0)
        out["speech_peak_p95"] = percentile(sorted(p for _, p in speech), 95.0)
        out["crest"] = out["speech_peak_p95"] - out["speech_rms"]
        return out


# --------------------------------------------------------------------------
# Which knob
# --------------------------------------------------------------------------

class Knob:
    """Which control the advice should name.

    With an external channel strip there are three gain stages and only one is
    the right one to move. The interface knob wants a fixed clean reference;
    the strip's INPUT gain sets how hard its compressor works and changes the
    sound; so the control that sets recording level is the strip's OUTPUT gain.
    """

    def __init__(self, name="the gain", deg_per_db=DEG_PER_DB, degrees=True,
                 preamp=None):
        self.name = name
        self.deg_per_db = deg_per_db
        self.degrees = degrees
        self.preamp = preamp

    @classmethod
    def for_preamp(cls, label):
        if not label:
            return cls()
        # No table of knob tapers: guessing degrees for a knob we have never
        # seen would be a confident lie. Name it, and let MIC_DEG_PER_DB
        # supply the taper if the user knows it.
        return cls(f"the {label} OUTPUT gain", DEG_PER_DB, DEG_PER_DB_KNOWN,
                   preamp=label)


KNOB = Knob()


def knob_hint(delta_db):
    """Turn the recommendation into something you can do with your hand."""
    mag = abs(delta_db)
    direction = "clockwise" if delta_db > 0 else "counter-clockwise"
    if mag < 1.0:
        return "it is close enough -- leave it"
    if mag < 2.5:
        size = "a hair"
    elif mag < 5.0:
        size = "a small nudge"
    elif mag < 10.0:
        size = "a noticeable turn"
    else:
        size = "a big turn"
    if not KNOB.degrees:
        return f"{size} {direction}"
    return f"{size} {direction} (~{mag * KNOB.deg_per_db:.0f} deg)"


# --------------------------------------------------------------------------
# Diagnosis
# --------------------------------------------------------------------------

OK, WARN, BAD = "ok", "warn", "bad"


class Finding:
    """One thing to change, or one thing confirmed fine.

    `reading` always carries the number the finding came from, so a tone
    heuristic can be argued with rather than taken on faith.
    """

    def __init__(self, area, severity, reading, control=None, action=None,
                 why=None):
        self.area = area
        self.severity = severity
        self.reading = reading
        self.control = control
        self.action = action
        self.why = why

    @property
    def actionable(self):
        return self.severity != OK and self.control is not None

    @property
    def short_control(self):
        """The control without the strip's name, for a report already
        headed by it."""
        if self.control and KNOB.preamp:
            prefix = f"the {KNOB.preamp} "
            if self.control.startswith(prefix):
                return self.control[len(prefix):]
        return self.control or ""


def diagnose_level(s, profile):
    """Level, headroom and clipping -- exact measurements, not heuristics."""
    target_rms, target_peak, _ = PROFILES[profile]

    if not s["alive"]:
        return [Finding("level", BAD, "no signal", KNOB.name,
                        "check the signal path",
                        "Nothing is reaching this input. Check the cable, the "
                        "input selector, and 48V if the mic is a condenser.")]
    if s["speech_rms"] is None:
        return [Finding("level", WARN, "too quiet to measure", KNOB.name,
                        "turn it up and talk",
                        "There is a signal, but it never rises far enough "
                        "above the noise to count as speech.")]

    for_rms = target_rms - s["speech_rms"]
    for_peak = target_peak - s["speech_peak_p95"]
    delta = min(for_rms, for_peak)
    out = []

    if s["clip_samples"] > 0 or s["max_peak"] > -0.5:
        down = max(abs(delta), 3.0)
        out.append(Finding(
            "level", BAD, f"{s['clip_samples']} clipped samples", KNOB.name,
            f"turn DOWN at least {down:.0f} dB -- {knob_hint(-down)}",
            "Samples are hitting full scale. That damage is permanent, and no "
            "amount of headphone volume will reveal it."))
    elif delta > RMS_TOLERANCE:
        limit = ("peaks are still low too" if for_peak > for_rms
                 else "peaks are what limit the rise")
        out.append(Finding(
            "level", WARN, f"speech at {s['speech_rms']:.1f} dBFS", KNOB.name,
            f"turn UP about {delta:.0f} dB -- {knob_hint(delta)}",
            f"Speech should average about {target_rms:.0f} dBFS; {limit}."))
    elif delta < -RMS_TOLERANCE:
        out.append(Finding(
            "level", WARN, f"speech at {s['speech_rms']:.1f} dBFS", KNOB.name,
            f"turn DOWN about {abs(delta):.0f} dB -- {knob_hint(delta)}",
            f"Speech should average about {target_rms:.0f} dBFS, and running "
            f"hot spends headroom you will want on a loud syllable."))
    else:
        held = "peaks" if for_peak < for_rms else "the average"
        out.append(Finding("level", OK,
                           f"speech {s['speech_rms']:.1f} dBFS, "
                           f"peaks {s['speech_peak_p95']:.1f}",
                           why=f"On target, with {held} the binding limit."))
    return out


def diagnose_dynamics(s, preamp):
    """Crest factor -> the compressor section."""
    crest = s["crest"]
    if crest is None:
        return []
    comp = f"the {preamp} COMPRESSOR (Drive)" if preamp else "a compressor"
    if crest > 17.0:
        return [Finding(
            "dynamics", WARN, f"crest {crest:.0f} dB -- uncompressed", comp,
            "raise Drive until the gain-reduction meter moves on loud words",
            "A crest factor this wide means nothing is levelling you. Quiet "
            "words will sit in the noise and loud ones will eat the headroom.")]
    if crest < 6.0:
        return [Finding(
            "dynamics", WARN, f"crest {crest:.0f} dB -- heavily compressed",
            comp, "back Drive off, or lower Density",
            "Almost no dynamic range left. This is where a voice starts to "
            "sound flat and pumped, and room noise gets pulled up between "
            "words.")]
    return [Finding("dynamics", OK, f"crest {crest:.0f} dB",
                    why="Healthy dynamic range for speech.")]


def diagnose_noise(s, preamp):
    """Noise floor and SNR -> the expander/gate."""
    out = []
    floor, rms = s["floor"], s["speech_rms"]
    gate = f"the {preamp} EXPANDER/GATE" if preamp else "a gate"

    if floor is not None and floor < -85.0:
        out.append(Finding(
            "noise", WARN, f"floor {floor:.0f} dBFS -- implausibly low", gate,
            "trust the SNR below only if the gate is open",
            "A floor this low is not a quiet room, it is an expander that has "
            "closed. Real room noise is higher than this reads."))
        return out
    if rms is None or floor is None:
        return out

    snr = rms - floor
    if snr < 25.0:
        out.append(Finding(
            "noise", BAD, f"SNR {snr:.0f} dB", gate,
            "get closer to the mic first, then raise Threshold if needed",
            "The noise is close enough to the voice that it will be audible "
            "under everything. A gate hides it between words but not during "
            "them -- distance and gain structure are the real fix."))
    elif snr < 35.0:
        out.append(Finding(
            "noise", WARN, f"SNR {snr:.0f} dB", gate,
            "raise Threshold until it closes between words",
            "Workable, but there is audible hiss between phrases."))
    else:
        out.append(Finding("noise", OK, f"SNR {snr:.0f} dB",
                           why="Voice sits well clear of the noise floor."))
    return out


def diagnose_tone(bands, preamp):
    """Band balance -> high-pass, de-esser and enhancer.

    Every threshold here is a heuristic on a ratio between bands, never on an
    absolute level, so that turning the gain knob cannot change the answer.
    Each finding reports its number so it can be disagreed with.
    """
    if not bands:
        return []
    out = []
    hpf = f"the {preamp} 80 Hz HIGH-PASS" if preamp else "an 80 Hz high-pass"
    deess = f"the {preamp} DE-ESSER" if preamp else "a de-esser"
    enh = f"the {preamp} ENHANCER" if preamp else "an EQ"

    rumble = bands["rumble"] - bands["low"]
    if rumble > -10.0:
        out.append(Finding(
            "rumble", WARN if rumble < -4 else BAD,
            f"sub-80 Hz is {rumble:+.0f} dB vs your fundamental", hpf,
            "switch it in",
            "That much energy below 80 Hz is desk thumps, footfall or HVAC, "
            "not voice. It eats headroom and muddies everything above it."))
    else:
        out.append(Finding("rumble", OK, f"sub-80 Hz {rumble:+.0f} dB",
                           why="Little below the voice, as it should be."))

    sib = bands["sibilance"] - bands["presence"]
    if sib > -3.0:
        out.append(Finding(
            "sibilance", WARN if sib < 0 else BAD,
            f"5-9 kHz is {sib:+.0f} dB vs presence", deess,
            "set Frequency near 6-7 kHz, then lower Threshold until the LED "
            "blinks on hard S sounds only",
            "Sibilance is close to the level of your presence band; a "
            "balanced voice sits about 6-14 dB below it. This is the harsh "
            "S and T sound."))
    else:
        out.append(Finding("sibilance", OK, f"5-9 kHz {sib:+.0f} dB",
                           why="Sibilance is in proportion to the voice."))

    mud = bands["lowmid"] - bands["mid"]
    if mud > 6.0:
        out.append(Finding(
            "body", WARN, f"200-500 Hz is {mud:+.0f} dB vs midrange", enh,
            "back off the mic a few inches, or reduce LF Detail",
            "A large low-mid build-up is usually proximity effect from being "
            "very close to a cardioid mic, and it reads as boxy or boomy."))
    elif mud < -10.0:
        out.append(Finding(
            "body", WARN, f"200-500 Hz is {mud:+.0f} dB vs midrange", enh,
            "try a little LF Detail",
            "The voice is thin through the low mids, which usually means the "
            "mic is far away or off-axis. This is the softest of these "
            "readings -- a naturally bright voice can measure the same way, "
            "so trust your ears over it."))
    else:
        out.append(Finding("body", OK, f"200-500 Hz {mud:+.0f} dB",
                           why="Low mids are in proportion."))

    air = bands["air"] - bands["presence"]
    if air < -28.0:
        out.append(Finding(
            "air", WARN, f"9-16 kHz is {air:+.0f} dB vs presence", enh,
            "add a little HF Detail",
            "Very little top end. Some of that is the microphone itself, so "
            "add sparingly and stop before the sibilance finding flips."))
    return out


def diagnose(summary, bands, profile, preamp):
    """Everything, most consequential first."""
    findings = (diagnose_level(summary, profile)
                + diagnose_noise(summary, preamp)
                + diagnose_dynamics(summary, preamp)
                + diagnose_tone(bands, preamp))
    rank = {BAD: 0, WARN: 1, OK: 2}
    return sorted(findings, key=lambda f: rank[f.severity])


def headline(findings):
    """(state, text) summarising the findings for the top of a panel."""
    todo = [f for f in findings if f.actionable]
    level = next((f for f in findings if f.area == "level"), None)
    if level is not None and level.severity == BAD:
        return (BAD, level.reading.upper() if "clip" in level.reading
                else "NO SIGNAL")
    if not todo:
        return (OK, "ALL GOOD")
    if any(f.severity == BAD for f in todo):
        return (BAD, f"{len(todo)} to fix")
    return (WARN, f"{len(todo)} to adjust")


