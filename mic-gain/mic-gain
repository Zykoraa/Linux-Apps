def phase(cap, seconds, meters, spec, message, palette, out, floor=None):
    start, last = time.monotonic(), 0.0
    while True:
        elapsed = time.monotonic() - start
        if elapsed >= seconds:
            break
        raw = cap.read_block()
        if raw is None:
            break
        left, right = unpack_block(raw)
        meters[0].process(left)
        meters[1].process(right)
        if spec is not None:
            lead = 0 if meters[0].max_peak >= meters[1].max_peak else 1
            gate = (meters[lead].rms_db >
                    max(floor + GATE_ABOVE_FLOOR, GATE_ABSOLUTE)
                    if floor is not None else meters[lead].live_gate())
            spec.feed((left, right)[lead], gate)
        now = time.monotonic()
        if now - last >= 0.1:
            last = now
            level = max(meters[0].rms_db, meters[1].rms_db)
            filled = int(min(max((level + 60) / 60, 0), 1) * 24)
            bar = (palette(zone_code(level), G.fill * filled)
                   + palette("2", G.empty * (24 - filled)))
            out.write(f"\r\033[2K  {message}  {seconds - elapsed:4.1f}s  {bar} "
                      f" {fmt_db(level)} dBFS")
            out.flush()
    out.write("\r\033[2K")
    out.flush()


def run_calibrate(cap, args, palette, source_desc, warn):
    c = palette
    out = sys.stderr if args.json else sys.stdout
    say = lambda t="": print(t, file=out)
    while True:
        quiet = [ChannelMeter(), ChannelMeter()]
        speech = [ChannelMeter(), ChannelMeter()]
        spec = Spectrum()

        say()
        say(c("1", "  Step 1 of 2 — silence."))
        say(c("2", "  Stop typing and stay quiet. Measuring the noise floor."))
        phase(cap, args.duration_quiet, quiet, None,
              "listening to the room", c, out)

        floors = [m.summary()["floor"] for m in quiet]
        lead_q = 0 if quiet[0].max_peak >= quiet[1].max_peak else 1
        say(c("2", f"  noise floor: L {fmt_db(floors[0])} dBFS   "
                   f"R {fmt_db(floors[1])} dBFS"))
        say()
        say(c("1", "  Step 2 of 2 — talk."))
        say(c("2", "  Speak normally, the way you actually would on a call or "
                   "stream, for the whole countdown."))
        phase(cap, args.duration_speech, speech, spec,
              "measuring your voice", c, out, floor=floors[lead_q])

        if not args.json:
            report(quiet, speech, spec, args, c, source_desc, warn)

        if args.json or not sys.stdin.isatty():
            return quiet, speech, spec
        print(c("2", "  Adjust the settings, then press Enter to measure "
                     "again — or Ctrl-C to finish."))
        try:
            input()
        except (EOFError, KeyboardInterrupt):
            print()
            return quiet, speech, spec


def lead_channel(summaries):
    live = [i for i, s in enumerate(summaries) if s["alive"]] or [0]
    return max(live, key=lambda i: summaries[i]["speech_rms"]
               if summaries[i]["speech_rms"] is not None else DB_FLOOR)


def report(quiet, speech, spec, args, c, source_desc, warn):
    target_rms, target_peak, desc = PROFILES[args.profile]
    qfloors = [m.summary()["floor"] for m in quiet]
    summaries = [m.summary(qfloors[i]) for i, m in enumerate(speech)]
    lead = lead_channel(summaries)
    s = summaries[lead]
    bands = spec.band_levels()
    findings = diagnose(s, bands, args.profile, KNOB.preamp)
    width = min(term_width(), 84)

    print()
    chain = f" · via {KNOB.preamp}" if KNOB.preamp else ""
    print("  " + c("1", "RESULT") + c("2", f"   {source_desc} · channel "
                                          f"{'LR'[lead]}{chain} · {args.profile}"))
    print(c("2", f"          {desc}"))
    print()

    def row(label, value, unit, note=""):
        val = fmt_db(value)
        print((f"    {label:<16}" + c("1", val) + c("2", f" {unit:<5}")
               + c("2", f"  {note}")).rstrip())

    print("  " + c("1", "LEVEL"))
    row("speech level", s["speech_rms"], "dBFS", f"target {target_rms:+.0f} "
        f"±{RMS_TOLERANCE:.0f}")
    row("peaks (p95)", s["speech_peak_p95"], "dBFS", f"target {target_peak:+.0f}")
    row("loudest peak", s["max_peak"], "dBFS",
        f"{-s['max_peak']:.1f} dB of headroom left"
        if s["max_peak"] > DB_FLOOR else "")
    row("crest factor", s["crest"], "dB", crest_note(s["crest"]))
    if s["clip_samples"]:
        print(f"    {'clipped':<16}" + c("1;31", f"{s['clip_samples']:>6}")
              + c("2", " samples"))
    print()

    print("  " + c("1", "NOISE"))
    row("noise floor", qfloors[lead], "dBFS", floor_note(qfloors[lead]))
    snr = (s["speech_rms"] - qfloors[lead]
           if s["speech_rms"] is not None and qfloors[lead] is not None else None)
    row("signal / noise", snr, "dB", snr_note(snr))
    print()

    if bands:
        print("  " + c("1", "TONE") + c("2", "   share of speech energy, "
                                             "relative to the whole voice"))
        peak_band = max(BANDS, key=lambda b: bands[b[0]])[0]
        area_band = {"rumble": "rumble", "sibilance": "sibilance",
                     "body": "lowmid", "air": "air"}
        hot = {area_band[f.area]: f.severity for f in findings
               if f.area in area_band and f.severity != OK}
        for name, _, _, label in BANDS:
            v = bands[name]
            n = max(0, min(26, int((v + 40) / 40 * 26)))
            colour = SEVERITY_COLOUR[hot[name]] if name in hot else "36;2"
            bar = c(colour, G.fill * n)
            tag = ("  <- most energy" if name == peak_band else
                   "  <- flagged" if name in hot else "")
            print((f"    {name:<10}{label:>8}  " + c("1", f"{v:6.1f}")
                   + c("2", " dB  ") + bar + c("2", tag)).rstrip())
        print()

    todo = [f for f in findings if f.actionable]
    strip = KNOB.preamp or "your chain"
    if todo:
        print("  " + c("1", f"WHAT TO CHANGE ON {strip.upper()}"))
        print()
        body_w = min(width - 10, 68)
        for i, fd in enumerate(todo, 1):
            colour = SEVERITY_COLOUR[fd.severity]
            print(f"    {c(colour + ';1', str(i) + '.')}  "
                  + c("1", fd.short_control))
            for line in wrap(fd.action, body_w):
                print(f"        {c(colour, line)}")
            for line in wrap(fd.why, body_w):
                print(c("2", f"        {line}"))
            print(c("2", f"        measured: {fd.reading}"))
            print()
    else:
        print("  " + c("1;32", f"{G.arrow} NOTHING TO CHANGE"))
        print(c("2", "    Every reading is inside its target range."))
        print()

    fine = [f for f in findings if f.severity == OK]
    if fine and todo:
        print(c("2", "    Already fine: "
                     + ", ".join(f.area for f in fine) + "."))
        print()
    if warn:
        print(c("2", f"    {warn}"))
        print()


def crest_note(crest):
    if crest is None:
        return ""
    if crest < 6:
        return "heavily compressed"
    if crest < 12:
        return "compressed"
    if crest < 18:
        return "natural speech dynamics"
    return "very dynamic — nothing is compressing"


def floor_note(floor):
    if floor is not None and floor < -85.0:
        return "suspiciously low — a gate is probably closing"
    return ""


def snr_note(snr):
    if snr is None:
        return ""
    if snr >= 45:
        return "excellent"
    if snr >= 35:
        return "good"
    if snr >= 25:
        return "audible hiss"
    return "noisy — mic too far away, or gain too low"


def emit_json(quiet, speech, spec, profile):
    import json
    qfloors = [m.summary()["floor"] for m in quiet]
    summaries = [m.summary(qfloors[i]) for i, m in enumerate(speech)]
    lead = lead_channel(summaries)
    s = dict(summaries[lead])
    bands = spec.band_levels()
    findings = diagnose(summaries[lead], bands, profile, KNOB.preamp)
    state, text = headline(findings)
    s.update({
        "channel": "LR"[lead], "profile": profile, "preamp": KNOB.preamp,
        "state": state, "headline": text, "bands": bands,
        "findings": [{"area": f.area, "severity": f.severity,
                      "reading": f.reading, "control": f.control,
                      "action": f.action, "why": f.why} for f in findings],
    })
    print(json.dumps(s, indent=2))


