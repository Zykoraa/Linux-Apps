class Palette:
    def __init__(self, enabled):
        self.on = enabled

    def __call__(self, code, text):
        return f"\033[{code}m{text}\033[0m" if self.on else text


SEVERITY_COLOUR = {OK: "32", WARN: "33", BAD: "31"}


class Glyphs:
    """Drawing characters, with an ASCII fallback.

    Every box-drawing, block and geometric-shape character here is East Asian
    "ambiguous" width. Terminals overwhelmingly render them narrow, which is
    what the frame padding assumes, but a terminal configured for wide
    ambiguous characters would shear every panel. --ascii is the escape hatch.
    """

    UNICODE = dict(
        tl="╭", tr="╮", bl="╰", br="╯", v="│", h="─",
        fill="█", hold="│", empty="·", band="─", tlo="├", thi="┤",
        tpeak="△", tick="┬", bars=" ▁▂▃▄▅▆▇█", dot="·", vtick="│", sep="·",
        ok="●", warn="▲", bad="■", arrow="▶", ell="…")
    ASCII = dict(
        tl="+", tr="+", bl="+", br="+", v="|", h="-",
        fill="#", hold="|", empty=".", band="-", tlo="[", thi="]",
        tpeak="^", tick="+", bars=" .:-=+*%#", dot=".", vtick="|", sep="-",
        ok="o", warn="!", bad="X", arrow=">", ell="...")

    def __init__(self, ascii_only=False):
        self.__dict__.update(self.ASCII if ascii_only else self.UNICODE)

    @property
    def marks(self):
        return {OK: self.ok, WARN: self.warn, BAD: self.bad}


G = Glyphs()


def zone_code(db):
    """Colour for a meter column representing this level."""
    if db < -30:
        return "36"
    if db < -12:
        return "32"
    if db < -6:
        return "92"
    if db < -3:
        return "33"
    return "31"


def term_width(default=100):
    try:
        return shutil.get_terminal_size((default, 24)).columns
    except Exception:
        return default


def ellipsize(text, width):
    if len(text) <= width:
        return text
    cut = text[:max(width - 1, 1)]
    space = cut.rfind(" ")
    if space > width // 2:
        cut = cut[:space]
    return cut.rstrip(" .,-") + G.ell


def wrap(text, width):
    words, line, out = text.split(), "", []
    for w in words:
        if len(line) + len(w) + 1 > width:
            out.append(line)
            line = w
        else:
            line = f"{line} {w}".strip()
    if line:
        out.append(line)
    return out


class LevelMeter:
    """The horizontal dBFS scale, its bars, and the target markers."""

    def __init__(self, width, palette):
        self.w = width
        self.c = palette

    def pos(self, db):
        db = min(max(db, DB_MIN), DB_MAX)
        return int(round((db - DB_MIN) / (DB_MAX - DB_MIN) * (self.w - 1)))

    def db_at(self, col):
        return DB_MIN + (DB_MAX - DB_MIN) * col / (self.w - 1)

    def ruler(self):
        ticks, labels = [" "] * self.w, [" "] * self.w
        last_start = self.w + 1
        for db in reversed(TICKS):
            p = self.pos(db)
            text = str(db)
            start = min(max(p - len(text) // 2, 0), self.w - len(text))
            if start + len(text) >= last_start:
                continue
            ticks[p] = G.tick
            labels[start:start + len(text)] = list(text)
            last_start = start
        return "".join(labels), "".join(ticks)

    def bar(self, rms_db, hold_db, lo_db, hi_db):
        fill = self.pos(rms_db) if rms_db > DB_MIN else -1
        hold = self.pos(hold_db) if hold_db > DB_MIN else -1
        lo, hi = self.pos(lo_db), self.pos(hi_db)
        out = []
        for i in range(self.w):
            db = self.db_at(i)
            if i <= fill:
                out.append(self.c(zone_code(db), G.fill))
            elif i == hold:
                out.append(self.c(zone_code(db) + ";1", G.hold))
            elif lo <= i <= hi:
                out.append(self.c("32;2", G.band))
            else:
                out.append(self.c("2", G.empty))
        return "".join(out)

    def targets(self, lo_db, hi_db, peak_db):
        row = [" "] * self.w
        lo, hi = self.pos(lo_db), self.pos(hi_db)
        for i in range(lo, hi + 1):
            row[i] = G.band
        row[lo], row[hi] = G.tlo, G.thi
        label = "level"
        if hi - lo >= len(label) + 2:
            start = (lo + hi - len(label)) // 2 + 1
            row[start:start + len(label)] = list(label)
        p = self.pos(peak_db)
        if 0 <= p < self.w and row[p] == " ":
            row[p] = G.tpeak
        return "".join(row)


def spectrum_plot(spec, columns, height, palette, flagged=()):
    """The analyzer display: log-frequency columns, block-character heights.

    Returns plot rows plus a frequency axis. Bands named in `flagged` get their
    axis label highlighted, so a de-esser finding is visible as a lit-up
    region of the spectrum rather than only as text.
    """
    c = palette
    data = spec.display(columns)
    rows = []
    for r in range(height):
        # Row 0 is the top of the plot.
        row_top = SPECTRUM_TOP - (SPECTRUM_RANGE * r / height)
        row_bot = SPECTRUM_TOP - (SPECTRUM_RANGE * (r + 1) / height)
        cells = []
        for db, hold in data:
            if db >= row_top:
                ch = G.fill
            elif db <= row_bot:
                ch = " "
            else:
                frac = (db - row_bot) / (row_top - row_bot)
                ch = G.bars[max(1, min(8, int(frac * 8 + 0.5)))]
            if ch == " " and row_bot < hold <= row_top:
                cells.append(c("2", G.dot))
            else:
                cells.append(c(zone_code(db), ch) if ch != " " else " ")
        rows.append("".join(cells))

    axis = [" "] * columns
    marks = [" "] * columns
    for hz, text in ((50, "50"), (100, "100"), (200, "200"), (500, "500"),
                     (1000, "1k"), (2000, "2k"), (4000, "4k"), (8000, "8k"),
                     (16000, "16k")):
        if not SPECTRUM_LO <= hz <= SPECTRUM_HI:
            continue
        frac = math.log(hz / SPECTRUM_LO) / math.log(SPECTRUM_HI / SPECTRUM_LO)
        p = min(columns - 1, max(0, int(frac * columns)))
        start = min(max(p - len(text) // 2, 0), columns - len(text))
        if all(axis[start + i] == " " for i in range(len(text))):
            axis[start:start + len(text)] = list(text)
            marks[p] = G.vtick

    # Highlight the frequency span of any flagged band.
    spans = []
    for name, lo, hi, _ in BANDS:
        if name not in flagged:
            continue
        f0 = math.log(max(lo, SPECTRUM_LO) / SPECTRUM_LO)
        f1 = math.log(min(hi, SPECTRUM_HI) / SPECTRUM_LO)
        d = math.log(SPECTRUM_HI / SPECTRUM_LO)
        spans.append((int(f0 / d * columns), int(f1 / d * columns)))

    def paint(line):
        if not spans:
            return c("2", line)
        out = []
        for i, ch in enumerate(line):
            hot = any(a <= i <= b for a, b in spans)
            out.append(c("33", ch) if hot else c("2", ch))
        return "".join(out)

    return rows, paint("".join(marks)), paint("".join(axis))


class Screen:
    """In-place redraw of a variable-height panel, without clearing scrollback."""

    def __init__(self, stream=sys.stdout):
        self.out = stream
        self.last_n = 0

    def __enter__(self):
        self.out.write("\033[?25l")
        return self

    def __exit__(self, *exc):
        self.out.write("\033[?25h")
        self.out.flush()
        return False

    def draw(self, lines):
        buf = [f"\033[{self.last_n}A"] if self.last_n else []
        for ln in lines:
            buf.append("\033[2K" + ln + "\n")
        extra = self.last_n - len(lines)
        if extra > 0:
            buf.extend(["\033[2K\n"] * extra)
            buf.append(f"\033[{extra}A")
        self.last_n = len(lines)
        self.out.write("".join(buf))
        self.out.flush()


class Keys:
    """Non-blocking single keypresses, when stdin is a terminal."""

    def __init__(self):
        self.fd = sys.stdin.fileno() if sys.stdin.isatty() else None
        self.saved = None

    def __enter__(self):
        if self.fd is not None:
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        return self

    def __exit__(self, *exc):
        if self.saved is not None:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        return False

    def get(self):
        if self.fd is None:
            return None
        if select.select([sys.stdin], [], [], 0)[0]:
            return sys.stdin.read(1)
        return None


