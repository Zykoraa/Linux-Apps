def show_list(sources, c):
    default, auto = default_source(), pick_source(sources)
    print()
    print("  " + c("1", "Inputs this can measure"))
    print()
    for s in sorted(sources, key=lambda x: (x["kind"] != "hardware",
                                            x["kind"] != "virtual", x["name"])):
        marks = []
        if s["name"] == auto:
            marks.append(c("1;32", "auto"))
        if s["name"] == default:
            marks.append(c("36", "system default"))
        note = ("  " + " ".join(marks)) if marks else ""
        print(f"    {c('1', s['name'])}{note}")
        print(f"      {c('2', s['desc'])}")
        print(f"      {c('2', s['kind'] + ', ' + (s['state'].lower() or 'unknown'))}")
    print()
    print(c("2", "  A hardware source measures the signal at the interface, "
                 "which is what the"))
    print(c("2", "  gain controls. A virtual one (bb_b1) measures what "
                 "applications record,"))
    print(c("2", "  after BetterBanana's processing."))
    print()


def main():
    p = argparse.ArgumentParser(
        prog="mic-gain",
        description="Analyze a microphone and say which control to change.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  mic-gain                       live analyzer: meters, spectrum, diagnosis
  mic-gain --calibrate           guided measurement -> a settings report
  mic-gain --list                show the inputs it can measure
  mic-gain --preamp 'dbx 286s'   name that strip's controls in the advice
  mic-gain -s bb_b1              measure what applications actually record
  mic-gain -p stream             aim for streaming levels instead

keys in the live view:
  q  quit          1  level only
  r  reset stats   2  spectrum only        3  full

gain staging with an external channel strip:
  Three knobs can change the level and only one of them should. Set the
  interface gain once to a clean reference and leave it (use the 1/4" TRS side
  of the combo jack, which is the line input -- an XLR cable puts the strip's
  line-level output into the interface's own mic preamp, stacking two of them).
  Set the strip's INPUT gain for the compression you want, watching its gain
  reduction meter, because that knob changes the sound and not just the level.
  Then set recording level with the strip's OUTPUT gain -- the knob --preamp
  makes this tool point at.

what is measured versus what is inferred:
  Level, peak, crest and clipping are exact. The tone findings are heuristics
  on ratios between frequency bands, and each one prints the number it came
  from so you can disagree with it. Nothing tonal is measured outside speech.

The knob-degree hints assume roughly 50 dB over a 300 degree sweep, which is
the interface knob; with --preamp they are suppressed unless MIC_DEG_PER_DB
is set, since the taper of an unknown knob is not worth guessing.""")
    p.add_argument("-s", "--source", default=os.environ.get("MIC_SOURCE"),
                   help="source to measure (default: auto-detect the mic)")
    p.add_argument("-p", "--profile", choices=sorted(PROFILES),
                   default=os.environ.get("MIC_PROFILE", "voice"),
                   help="what you are levelling for (default: voice)")
    p.add_argument("-c", "--calibrate", action="store_true",
                   help="guided measurement and a written settings report")
    p.add_argument("-l", "--list", action="store_true",
                   help="list candidate sources and exit")
    p.add_argument("--preamp", default=os.environ.get("MIC_PREAMP"),
                   metavar="NAME",
                   help="external preamp / channel strip between mic and "
                        "interface (e.g. 'dbx 286s'). Names its controls in "
                        "the advice, and points level changes at its OUTPUT "
                        "gain rather than the interface")
    p.add_argument("--view", choices=("level", "spectrum", "full"),
                   default="full", help="starting live view (default: full)")
    p.add_argument("--duration-quiet", type=float, default=5.0, metavar="SEC",
                   help="silence phase length (default: 5)")
    p.add_argument("--duration-speech", type=float, default=15.0, metavar="SEC",
                   help="speech phase length (default: 15)")
    p.add_argument("--latency", default="25ms",
                   help="capture latency passed to pw-record (default: 25ms)")
    p.add_argument("--json", action="store_true",
                   help="with --calibrate, print the result as JSON")
    p.add_argument("--ascii", action="store_true",
                   help="draw with ASCII only, for terminals that render "
                        "box-drawing characters double-width")
    p.add_argument("--no-color", action="store_true", help="disable colour")
    args = p.parse_args()

    global KNOB, G
    KNOB = Knob.for_preamp(args.preamp)
    G = Glyphs(args.ascii)

    colour = (sys.stdout.isatty() and not args.no_color
              and not os.environ.get("NO_COLOR"))
    c = Palette(colour)

    sources = list_sources()
    if not sources:
        print("No audio sources found. Is PipeWire running?", file=sys.stderr)
        return 1

    if args.list:
        show_list(sources, c)
        return 0

    target = args.source or pick_source(sources)
    info = find(sources, target)
    if info is None and args.source:
        print(f"No source named {target!r}. Try --list.", file=sys.stderr)
        return 1

    desc = info["desc"] if info else target
    warn = ""
    if info and info["volume_db"] not in (None, 0.0):
        warn = (f"note: this source has {info['volume_db']:+.1f} dB of software "
                f"volume on top of the hardware controls")
    if info and info["kind"] == "monitor":
        warn = "note: this is a monitor of an output, not a microphone input"

    try:
        with Capture(target, args.latency) as cap:
            first = cap.read_block()
            if first is None:
                err = cap.stderr_text()
                print(f"Could not capture from {target!r}.", file=sys.stderr)
                if err:
                    print(err, file=sys.stderr)
                return 1
            del first   # 21 ms, discarded: it only proved the stream opened
            if args.calibrate:
                quiet, speech, spec = run_calibrate(cap, args, c, desc, warn)
                if args.json:
                    emit_json(quiet, speech, spec, args.profile)
            else:
                run_live(cap, args, c, desc, warn)
    except KeyboardInterrupt:
        sys.stdout.write("\033[?25h\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
