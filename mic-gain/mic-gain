def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def list_sources():
    states = {}
    for line in _run(["pactl", "list", "short", "sources"]).splitlines():
        parts = line.split("\t")
        if len(parts) >= 5:
            states[parts[1]] = parts[-1].strip()

    sources, cur = [], None
    for line in _run(["pactl", "list", "sources"]).splitlines():
        if line.startswith("Source #"):
            cur = {"name": "", "desc": "", "monitor": None, "volume_db": None}
            sources.append(cur)
        elif cur is not None:
            s = line.strip()
            if s.startswith("Name: "):
                cur["name"] = s[6:]
            elif s.startswith("Description: "):
                cur["desc"] = s[13:]
            elif s.startswith("Monitor of Sink: "):
                v = s[17:]
                cur["monitor"] = None if v == "n/a" else v
            elif s.startswith("Volume: ") and cur["volume_db"] is None:
                m = re.search(r"(-?\d+(?:\.\d+)?) dB", s)
                if m:
                    cur["volume_db"] = float(m.group(1))
    for s in sources:
        s["state"] = states.get(s["name"], "")
        s["kind"] = ("monitor" if s["monitor"]
                     else "hardware" if s["name"].startswith("alsa_input.")
                     else "virtual")
    return sources


def default_source():
    return _run(["pactl", "get-default-source"]).strip()


def pick_source(sources):
    """Guess the microphone.

    A score, not a rule, because every signal is only suggestive: hardware
    beats virtual, already RUNNING is almost certainly the mic wired into your
    chain, USB beats onboard, and a webcam is a mic of last resort.
    """
    best, best_score = None, -1
    for s in sources:
        if s["kind"] != "hardware":
            continue
        blob = (s["name"] + " " + s["desc"]).lower()
        score = 0
        if s["state"] == "RUNNING":
            score += 4
        if "usb" in blob:
            score += 2
        if not any(w in blob for w in ("webcam", "camera", "hdmi")):
            score += 1
        if score > best_score:
            best, best_score = s, score
    return best["name"] if best else default_source()


def find(sources, name):
    return next((s for s in sources if s["name"] == name), None)


class Capture:
    """A pw-record process delivering interleaved float32 blocks."""

    def __init__(self, target, latency="25ms"):
        self.target, self.latency = target, latency
        self.proc = self.err = self.err_path = None

    def __enter__(self):
        import tempfile
        fd, self.err_path = tempfile.mkstemp(prefix="bb-mic-", suffix=".err")
        self.err = os.fdopen(fd, "w+")
        self.proc = subprocess.Popen(
            ["pw-record", "--target", self.target, "--rate", str(RATE),
             "--channels", str(CHANNELS), "--format", "f32",
             "--latency", self.latency, "-"],
            stdout=subprocess.PIPE, stderr=self.err, bufsize=0)
        return self

    def __exit__(self, *exc):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        try:
            self.err.close()
        except OSError:
            pass
        if self.err_path:
            try:
                os.unlink(self.err_path)
            except OSError:
                pass
        return False

    def stderr_text(self):
        try:
            self.err.flush()
            self.err.seek(0)
            return self.err.read().strip()
        except OSError:
            return ""

    def read_block(self):
        want, chunks = BLOCK_BYTES, []
        while want:
            b = self.proc.stdout.read(want)
            if not b:
                return None
            chunks.append(b)
            want -= len(b)
        return chunks[0] if len(chunks) == 1 else b"".join(chunks)


def unpack_block(raw):
    frames = struct.unpack(f"<{len(raw) // 4}f", raw)
    return frames[0::2], frames[1::2]


