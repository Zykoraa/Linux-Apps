{
    "name": "evecord",
    "productName": "Evecord",
    "desktopName": "evecord.desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Eve's own Discord desktop app: Discord web in Electron with Vencord built in, made for Linux and PipeWire",
    "license": "GPL-3.0-or-later",
    "author": "Zykoraa",
    "main": "dist/main.js",
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:dev": "node scripts/build.mjs --dev",
        "watch": "node scripts/build.mjs --dev --watch",
        "start": "node scripts/build.mjs --dev && electron .",
        "typecheck": "tsc --noEmit",
        "test": "tsc --noEmit && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'test/*.test.ts'"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.2.3"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "19.2.9",
        "@vencord/types": "^1.15.1",
        "arrpc": "github:Vencord/arrpc#1dc801e8ea14d96ce8dccff416417614f058afb8",
        "electron": "44.5.1",
        "esbuild": "^0.28.2",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22"
    }
}
