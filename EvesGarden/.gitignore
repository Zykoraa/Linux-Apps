bin/

# ----------------------------------------------------------------- user data
# Downloads, the index and per-machine state all live under ~/.config,
# ~/.local/share and ~/.cache now (see xdg_paths.py), so nothing of the
# user's should ever appear here. These are for a stray run from a checkout.
library.db
settings.json
*.log

