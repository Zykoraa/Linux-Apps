#!/usr/bin/env python3
"""Keep Discord's screen-share capture wired to the right BetterBanana bus.

Two things go wrong when you share your screen on Discord while running a
Voicemeeter-style mixer, and neither is obvious from the Discord UI.

1. ECHO. Discord auto-links its capture to every bb_a* output bus it can see.
   Those buses carry the AUX strip -- the voice of the people you are talking to
   -- so everyone in the call hears themselves played back inside your stream.

2. THE WRONG CAPTURE NODE. Discord runs SEVERAL nodes all named
   "discord_capture", one per playback stream it captures, each carrying a
   target.object naming that stream. `pw-link` matches ports by NAME, so
   linking "bus -> discord_capture" picks an instance by luck.

3. DOUBLED AUDIO. Sharing the entire screen makes Discord capture every
   application's playback stream itself and MIX the captures. An app that also
   reaches the stream bus is heard twice, and the bus fed into several captures
   is heard several times -- each copy offset by its own buffer, which is comb
   filtering: viewers hear the stream "as if in a chamber".

This daemon fixes all three. Every couple of seconds it:

  * drops links into discord_capture from any bus the AUX strip feeds (fixes 1),
  * attaches your dedicated stream bus, by port id, to the ONE capture Discord
    made for the stream bus itself (fixes 2); with no such capture (sharing a
    single window), to every capture instead,
  * once a stream bus exists, drops every other link into discord_capture,
    so viewers hear exactly one copy of the stream bus (fixes 3),
  * re-creates the stream bus if it vanished. A null sink with nothing playing
    gets suspended as idle, which tears down BetterBanana's output node for that
    bus; the stream then goes silent until something restarts the chain.

The stream bus is discovered, not hardcoded: it is whichever A-bus you have
assigned to the stream sink (default "betterbanana_stream"). If no bus is assigned to it,
stream-bus management stays off and only the echo protection runs -- so this is
safe to enable even if you never share your screen.

Set up the stream bus by pointing an unused bus at the null sink and routing the
strips you want streamed to it, leaving AUX off it:

    bb-ctl route out A3 betterbanana_stream
    bb-ctl strip <app-strip> bus A3 1

Environment:
    BB_GUARD_STREAM_SINK  sink that marks the stream bus   (default betterbanana_stream)
    BB_GUARD_BLOCK        override auto-detected bus block list, e.g. "bb_a1 bb_a2"
    BB_GUARD_EXCLUSIVE    0 keeps Discord's own app capture alongside the
                          stream bus                       (default 1)
    BB_GUARD_INTERVAL     poll seconds                     (default 2)
    BB_GUARD_BBCTL        path to bb-ctl                   (default ~/.local/bin/bb-ctl)
"""
import json
import os
import re
import subprocess
import sys
import time

STREAM_SINK = os.environ.get("BB_GUARD_STREAM_SINK", "betterbanana_stream")
BLOCK_OVERRIDE = os.environ.get("BB_GUARD_BLOCK", "").split()
EXCLUSIVE = os.environ.get("BB_GUARD_EXCLUSIVE", "1") != "0"
INTERVAL = float(os.environ.get("BB_GUARD_INTERVAL", "2"))
BBCTL = os.environ.get("BB_GUARD_BBCTL", os.path.expanduser("~/.local/bin/bb-ctl"))

TARGET = "discord_capture"
CHANNELS = ("FL", "FR")
ROUTING_RE = re.compile(r"\bA1([-*])\s+A2([-*])\s+A3([-*])\s+B1[-*]\s+B2[-*]")
# What follows GAIN MUTE MONO EQ in a bus row: MODE (one or more words, "-" for the
# B buses), LATENCY ("12.3ms" or "-"), DELAY ("0.0ms"), ARRIVES ("12.3ms" or "-"),
# LUFS-S, LUFS-I, then the device, which may itself contain spaces
# ("(virtual source)"). The timing columns have fixed shapes, so the lazy MODE
# group stops exactly where LATENCY starts, even for "TV mix" or "Up-mix 2.1".
BUS_TAIL_RE = re.compile(
    r"^(?P<mode>.+?)\s+(?:\d+(?:\.\d+)?ms|-)\s+-?\d+(?:\.\d+)?ms\s+(?:\d+(?:\.\d+)?ms|-)"
    r"\s+\S+\s+\S+\s+(?P<device>.+)$")
# The AUX strip is the virtual input Discord's voice output plays into. It is the
# last strip BetterBanana exposes, and the one that must never reach the stream.
AUX_STRIP_INDEX = 4


def run(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ""


def bus_device(rest):
    """The device column, given the fields after GAIN MUTE MONO EQ.

    bb-ctl grew MODE, LATENCY, DELAY, ARRIVES and LUFS columns between EQ and the
    device. Treating everything after EQ as the device made every bus read as
    "Normal 0.0ms ... betterbanana_stream", so no bus ever matched the stream sink.
    A row without those columns (an older bb-ctl) is still taken whole.
    """
    tail = " ".join(rest).strip()
    m = BUS_TAIL_RE.match(tail)
    return m.group("device").strip() if m else tail


def parse_bus_row(line):
    """Device name from one bus row, or None if the line is not a bus row.

    A row is "<label> <gain> <mute> <mono> <eq> <device>", but both the label and
    the device may contain spaces ("(dont change)", "(virtual source)"), so anchor
    on a float followed by three integers -- and take the LAST such block on the
    line, not the first. A device name never contains one, but a bus label is free
    to: naming a bus "0.0 0 0 0 x" would otherwise hijack the parse.
    """
    f = line.split()
    for i in range(len(f) - 5, -1, -1):
        try:
            float(f[i])
            for j in (1, 2, 3):
                int(f[i + j])
        except ValueError:
            continue
        return bus_device(f[i + 4:])
    return None


def mixer_state():
    """(aux_buses, stream_bus, all_buses) as node names, e.g. ({'bb_a1'}, 'bb_a3')."""
    text = run(BBCTL, "status")
    aux_buses, stream_bus, section = set(), None, None
    all_buses = set()
    strip_rows = []
    bus_rows = []

    for line in text.splitlines():
        head = line.split()[:1]
        if head == ["STRIP"]:
            section = "strip"
            continue
        if head == ["BUS"]:
            section = "bus"
            continue
        if not line.strip():
            continue

        if section == "strip":
            m = ROUTING_RE.search(line)
            if m:
                strip_rows.append(m.groups())
        elif section == "bus":
            row = parse_bus_row(line)
            if row is None:
                continue
            bus_rows.append(row)

    # Buses print in a fixed order -- A1 A2 A3 B1 B2 -- and only the A buses can
    # carry a device. Position is the only reliable identifier: the first column
    # holds the bus LABEL, which the user is free to rename, so matching on "A1"
    # finds nothing the moment anyone renames a bus.
    for i, dev in enumerate(bus_rows[:3], start=1):
        all_buses.add(f"bb_a{i}")
        if dev == STREAM_SINK:
            stream_bus = f"bb_a{i}"

    if len(strip_rows) > AUX_STRIP_INDEX:
        for i, flag in enumerate(strip_rows[AUX_STRIP_INDEX], start=1):
            if flag == "*":
                aux_buses.add(f"bb_a{i}")

    return aux_buses, stream_bus, all_buses


def ports(flag):
    """{'bb_a3:output_FL': [port_id, ...]} for -o (outputs) or -i (inputs)."""
    out = {}
    for line in run("pw-link", "-I", flag).splitlines():
        f = line.split()
        if len(f) >= 2 and f[0].isdigit():
            out.setdefault(f[1], []).append(int(f[0]))
    return out


def links():
    """[(link_id, out_port_id, in_port_id)] with direction normalised."""
    found, cur = [], None
    for line in run("pw-link", "-I", "-l").splitlines():
        f = line.split()
        if not f or not f[0].isdigit():
            continue
        if "|->" in line or "|<-" in line:
            if len(f) >= 3 and f[2].isdigit() and cur is not None:
                lid, peer = int(f[0]), int(f[2])
                found.append((lid, cur, peer) if "|->" in line else (lid, peer, cur))
        else:
            cur = int(f[0])
    return found


_fallback_logged = False


def own_capture_ports(stream_bus):
    """Input port ids of the discord_capture node(s) Discord made for the stream
    bus's own playback stream -- matched by target.object == the bus node's
    object.serial. Empty when Discord is not capturing the bus (window share)."""
    try:
        graph = json.loads(run("pw-dump") or "[]")
    except ValueError:
        return set()
    serial, nodes = None, set()
    for o in graph:
        if o.get("type") != "PipeWire:Interface:Node":
            continue
        props = (o.get("info") or {}).get("props") or {}
        if props.get("node.name") == stream_bus:
            serial = str(props.get("object.serial"))
    for o in graph:
        if o.get("type") != "PipeWire:Interface:Node":
            continue
        props = (o.get("info") or {}).get("props") or {}
        if props.get("node.name") == TARGET and serial and \
                str(props.get("target.object")) == serial:
            nodes.add(o["id"])
    return {o["id"] for o in graph
            if o.get("type") == "PipeWire:Interface:Port"
            and (o.get("info") or {}).get("direction") == "input"
            and ((o.get("info") or {}).get("props") or {}).get("node.id") in nodes}


def tick():
    inputs = ports("-i")
    cap = {c: inputs.get(f"{TARGET}:input_{c}", []) for c in CHANNELS}
    if not any(cap.values()):
        return  # nothing is capturing; nothing to police

    aux_buses, stream_bus, all_buses = mixer_state()
    outputs = ports("-o")

    # A suspended null sink takes the bus node down with it. bb-ctl still knows
    # the assignment, so re-issuing it brings the node back.
    if stream_bus and not outputs.get(f"{stream_bus}:output_FL"):
        run(BBCTL, "route", "out", f"A{stream_bus[-1]}", STREAM_SINK)
        print(f"bb-stream-guard: {stream_bus} was missing - re-assigned to {STREAM_SINK}",
              flush=True)
        time.sleep(1)
        outputs = ports("-o")

    # With a stream bus configured, it is the ONLY bus allowed to feed Discord:
    # any other bus either carries AUX (echo) or duplicates audio the stream bus
    # already delivers (comb filtering). Without one, fall back to protecting
    # against the echo alone and leave Discord's own capture untouched.
    if BLOCK_OVERRIDE:
        blocked = set(BLOCK_OVERRIDE)
    elif stream_bus:
        blocked = set(all_buses)
    else:
        blocked = set(aux_buses)
    blocked.discard(stream_bus)

    existing = sorted(set(links()))  # pw-link -l lists every link from both ends
    cap_ids = {i for ids in cap.values() for i in ids}

    blocked_ids = set()
    for bus in blocked:
        for c in CHANNELS:
            blocked_ids.update(outputs.get(f"{bus}:output_{c}", []))
    stream_ids = set()
    if stream_bus:
        for c in CHANNELS:
            stream_ids.update(outputs.get(f"{stream_bus}:output_{c}", []))
    port_names = {pid: name for name, ids in outputs.items() for pid in ids}

    # Discord mixes every capture it runs, so the stream bus must reach exactly
    # one of them: the capture Discord made for the bus's own stream. Without one
    # (a single window is shared, so Discord is not capturing the bus) feed them all.
    global _fallback_logged
    feed = cap_ids
    if stream_bus:
        own = own_capture_ports(stream_bus) & cap_ids
        if own:
            feed = own
            _fallback_logged = False
        elif not _fallback_logged:
            print(f"bb-stream-guard: Discord is not capturing {stream_bus} itself "
                  f"(window share?) - feeding every {TARGET}", flush=True)
            _fallback_logged = True

    for lid, o, i in existing:
        if i not in cap_ids:
            continue
        if o in blocked_ids:
            why = "bus carrying AUX"
        elif EXCLUSIVE and stream_ids and o not in stream_ids:
            # Discord's own per-app capture: the stream bus already carries it.
            why = f"{port_names.get(o, o)}, not the stream bus"
        elif o in stream_ids and i not in feed:
            why = f"{port_names.get(o, o)} into a second capture: a duplicate copy"
        else:
            continue
        run("pw-link", "-d", str(lid))
        print(f"bb-stream-guard: dropped link {lid} ({why} -> {TARGET})", flush=True)

    if not stream_bus:
        return  # no stream bus configured; echo protection only

    pairs = {(o, i) for _, o, i in existing}
    for c in CHANNELS:
        for src in outputs.get(f"{stream_bus}:output_{c}", []):
            for dst in cap[c]:
                if dst in feed and (src, dst) not in pairs:
                    run("pw-link", str(src), str(dst))
                    print(f"bb-stream-guard: attached {stream_bus}:output_{c} "
                          f"({src}) -> {TARGET} port {dst}", flush=True)


def main():
    while True:
        try:
            tick()
        except Exception as e:  # a transient graph read must never kill the guard
            print(f"bb-stream-guard: {e}", file=sys.stderr, flush=True)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
