#!/bin/sh
# bb-stream-setup - set up the stream bus for Discord screen sharing.
#
# Kept for anyone (and any keybind) that already calls it. It used to be a
# python script that read `bb-ctl status` as text; the setup now lives in the
# mixer itself (common/streamsetup.h), shared with the GUI's Stream dialog.
#
#     bb-stream-setup [--bus A1|A2|A3] [--bus-only] [--autolevel] [--dry-run]
#
# --sink is accepted and ignored: the engine creates the one stream sink itself.
BBCTL="${BB_SETUP_BBCTL:-$(command -v bb-ctl || echo "$HOME/.local/bin/bb-ctl")}"
args=""
while [ $# -gt 0 ]; do
    case "$1" in
        --sink) shift ;;                       # its value is dropped below
        --sink=*) ;;
        *) args="$args $1" ;;
    esac
    shift
done
# shellcheck disable=SC2086 # the arguments are single words by construction
exec "$BBCTL" stream setup $args
